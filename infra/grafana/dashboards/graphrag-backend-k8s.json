{
    "uid":  "graphrag-backend-k8s",
    "title":  "GraphRAG Backend (k8s)",
    "tags":  [
                 "graphrag",
                 "backend"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "10s",
    "time":  {
                 "from":  "now-30m",
                 "to":  "now"
             },
    "templating":  {
                       "list":  [

                                ]
                   },
    "panels":  [
                   {
                       "id":  1,
                       "title":  "Backend RPS по маршрутам",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  0
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "sum(rate(http_requests_total{job=\"backend-k8s\"}[1m])) by (route)",
                                           "legendFormat":  "{{route}}"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  2,
                       "title":  "HTTP latency p50 / p95",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  0
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"backend-k8s\"}[5m])) by (le))",
                                           "legendFormat":  "p50"
                                       },
                                       {
                                           "expr":  "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"backend-k8s\"}[5m])) by (le))",
                                           "legendFormat":  "p95"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "s"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  3,
                       "title":  "Статусы чата (ok/degraded/empty)",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  8,
                                       "x":  0,
                                       "y":  8
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "sum(rate(chat_status_total[5m])) by (status)",
                                           "legendFormat":  "{{status}}"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  4,
                       "title":  "События guardrails (по типу)",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  8,
                                       "x":  8,
                                       "y":  8
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "sum(increase(guardrail_events_total[15m])) by (kind)",
                                           "legendFormat":  "{{kind}}"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  5,
                       "title":  "Итерации агента (среднее за ход)",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  8,
                                       "x":  16,
                                       "y":  8
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "sum(rate(agent_iterations_sum[5m])) / sum(rate(agent_iterations_count[5m]))",
                                           "legendFormat":  "avg iterations"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "min":  0
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  6,
                       "title":  "Узлы графа: latency p95",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  16
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.95, sum(rate(graph_node_duration_seconds_bucket[5m])) by (le, node))",
                                           "legendFormat":  "{{node}}"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "s"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  7,
                       "title":  "Размер контекста (чанков после rerank)",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  6,
                                       "x":  12,
                                       "y":  16
                                   },
                       "datasource":  "Prometheus",
                       "targets":  [
                                       {
                                           "expr":  "sum(rate(rag_context_chunks_sum[5m])) / sum(rate(rag_context_chunks_count[5m]))",
                                           "legendFormat":  "avg chunks"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "min":  0
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   }
               ]
}