# ============================================================
# GraphRAG Platform - шаблон окружения (этап 2)
# Скопировать в .env и заполнить: cp .env.example .env
# Реальный .env НИКОГДА не коммитится.
# ============================================================

# --- Реестры/источники при блокировках (план Б, ADR-011) ---
# Пусто = официальные Docker Hub / PyPI / HuggingFace
APP_DOCKER_REGISTRY=
PIP_INDEX_URL=https://pypi.org/simple
HF_ENDPOINT=

# --- Порты на хосте (все биндятся ТОЛЬКО на 127.0.0.1) ---
APP_TRAEFIK_HTTP_PORT=80
APP_BACKEND_PORT=8000
APP_POSTGRES_PORT=5432
APP_QDRANT_HTTP_PORT=6333
APP_QDRANT_GRPC_PORT=6334
APP_NEO4J_HTTP_PORT=7474
APP_NEO4J_BOLT_PORT=7687
APP_VAULT_PORT=8200

# --- PostgreSQL (пользователи/роли/сессии/аудит) ---
APP_PG_USER=graphrag
APP_PG_PASSWORD=dev_pg_password
APP_PG_DB=graphrag

# --- Neo4j Community (граф знаний) ---
# Пароль минимум 8 символов, иначе контейнер не стартует
APP_NEO4J_PASSWORD=dev_neo4j_password
# Bolt-подключение backend к графу (хост-запуск; в compose подменяется на bolt://neo4j:7687)
APP_NEO4J_URI=bolt://127.0.0.1:7687
APP_NEO4J_USER=neo4j

# --- Qdrant (векторная БД) ---
# Хост-запуск скриптов/CLI; в compose подменяется на http://qdrant:6333
APP_QDRANT_URL=http://127.0.0.1:6333
APP_QDRANT_COLLECTION=chunks

# --- Vault dev-mode (хранение секретов по заданию) ---
# Токен root для дев-режима; в прод-конфигурации заменяется Vault Agent/AppRole
APP_VAULT_DEV_ROOT_TOKEN=dev_root_token

# --- Grafana ---
APP_GRAFANA_ADMIN_USER=admin
APP_GRAFANA_ADMIN_PASSWORD=dev_grafana_password

# --- LLM Serving (OpenAI-совместимый API) ---
# Dev-режим: LM Studio на хосте (ADR-001, дополнение). Изнутри docker-сети
# хост доступен как host.docker.internal; из скриптов на хосте - 127.0.0.1.
APP_LLM_BASE_URL=http://host.docker.internal:1234/v1
APP_LLM_API_KEY=lm-studio
APP_LLM_MODEL=qwen/qwen3.5-9b

# Переключение на целевой vLLM (docker-compose.gpu.yml): раскомментировать,
# когда vllm поднят; имя модели - см. ADR-002 (Qwen3-8B-AWQ)
# APP_LLM_BASE_URL=http://vllm:8000/v1
# APP_LLM_MODEL=Qwen/Qwen3-8B-AWQ

# --- vLLM (опционально, docker-compose.gpu.yml - целевой движок демо) ---
# Для быстрого smoke можно взять маленькую модель
APP_VLLM_MODEL=Qwen/Qwen3-0.6B
APP_VLLM_SERVED_NAME=qwen3-smoke
APP_VLLM_MAX_MODEL_LEN=4096
APP_VLLM_GPU_MEM_UTIL=0.85

# --- Embeddings (bge-m3, CPU-in-process, ADR-009) ---
APP_EMBEDDING_MODEL=BAAI/bge-m3
APP_EMBEDDING_BATCH_SIZE=32
APP_EMBEDDING_DEVICE=cpu

# --- Чанкинг / Ingestion (этап 4) ---
APP_CHUNK_MAX_CHARS=1800
APP_CHUNK_OVERLAP_CHARS=200
# Каталог корпуса XML на ХОСТЕ для bind mount в backend (/data/corpus).
# Живой маунт: новые XML можно докладывать в эту папку без пересборки и
# перезапуска; прогон POST /admin/ingest обрабатывает только дельту (sha256).
# Абсолютный путь или путь относительно infra/
CORPUS_HOST_DIR=../corpus_test
# Каталог корпуса для CLI-запуска с хоста (внутри контейнера всегда /data/corpus)
APP_INGEST_CORPUS_DIR=../corpus_test
# LLM-экстракция (:Concept) - требует работающего LM Studio/vLLM; false = только детерминированная часть графа
APP_INGEST_EXTRACT_CONCEPTS=false
# Разметка clearance детерминированным hash от act_id (остаток - PUBLIC).
# ВНИМАНИЕ: смена процентов меняет гриф - после неё нужен полный прогон
# (POST /admin/ingest?full=true или CLI --full), иначе payload Qdrant устареет
APP_INGEST_INTERNAL_PERCENT=20
APP_INGEST_SECRET_PERCENT=10
# Максимум Concept-ов, извлекаемых из одного чанка
APP_INGEST_CONCEPT_MAX_PER_CHUNK=6
# Лимит размера одного файла при загрузке через POST /admin/documents (МБ)
APP_INGEST_MAX_UPLOAD_MB=20

# --- Query pipeline / агент (этап 5) ---
# Retrieval: топ-K векторных кандидатов, финальный топ-N после rerank, глубина расширения графа (1-2)
APP_RAG_VECTOR_TOP_K=8
APP_RAG_FINAL_TOP_N=5
APP_RAG_GRAPH_HOPS=1
# Agent Loop: максимум итераций re-plan после generate (evaluate -> planner)
APP_AGENT_MAX_ITERATIONS=2
# Генерация ответа
APP_GENERATE_TEMPERATURE=0.2
APP_GENERATE_MAX_TOKENS=1024
# Бюджет символов блока источников в промпте генерации (этап 9): переполненный
# контекст ломает генерацию на моделях с малым окном (сервер теряет user-запрос)
APP_GENERATE_CTX_CHAR_BUDGET=9000
# Reranker (bge-reranker-v2-m3, CPU-in-process, ADR-009)
APP_RERANK_MODEL=BAAI/bge-reranker-v2-m3
APP_RERANK_DEVICE=cpu
# Память агента: сколько последних сообщений сессии попадает в контекст графа
APP_CHAT_HISTORY_LIMIT=8
# Guardrails: лимит длины запроса; LLM-классификатор инъекций (санитайзер работает всегда)
APP_GUARDRAIL_MAX_QUERY_CHARS=2000
APP_GUARDRAIL_USE_LLM=true
# --- Трейсинг: экспорт спанов в otel-collector стека graphrag-observability ---
# Стек наблюдаемости - ОТДЕЛЬНЫЙ compose-проект (docker-compose.observability.yml):
# из контейнеров ходим через host.docker.internal на опубликованный хост-порт.
APP_TRACING_ENABLED=true
APP_OTEL_EXPORTER_ENDPOINT=http://host.docker.internal:4318/v1/traces
# Публикация OTLP/HTTP коллектора на хост (для экспорта из хост-процессов/тестов)
APP_OTEL_HTTP_PORT=4318

# --- Кэш моделей HuggingFace (compose, этап 5) ---
# В backend монтируется volume hf_cache -> /hf-cache (HF_HOME).
# Без него каждая пересозданная тара качает bge-m3 и reranker заново.

# --- Langfuse self-hosted стек (ОПЦИОНАЛЬНО, infra/docker-compose.langfuse.yml, этап 7) ---
# Поднимается отдельно: cd infra && docker compose -f docker-compose.langfuse.yml up -d
# UI: http://langfuse.localhost (через Traefik) или http://127.0.0.1:${APP_LANGFUSE_PORT}
APP_LANGFUSE_PORT=3300
APP_LANGFUSE_POSTGRES_PASSWORD=dev_langfuse_pg_password
APP_LANGFUSE_CLICKHOUSE_PASSWORD=dev_langfuse_ch_password
APP_LANGFUSE_MINIO_ROOT_USER=langfuse-minio
APP_LANGFUSE_MINIO_ROOT_PASSWORD=dev_langfuse_minio_password
# Секреты приложения Langfuse (для не-dev сгенерировать заново: openssl rand -base64 32)
APP_LANGFUSE_NEXTAUTH_SECRET=dev_langfuse_nextauth_secret_change_me
APP_LANGFUSE_SALT=dev_langfuse_salt_change_me_32chars_long!!
APP_LANGFUSE_ENCRYPTION_KEY=dev_langfuse_encryption_key_change_me_64_hex_chars_0000000000000000000000000000
APP_LANGFUSE_INIT_USER_PASSWORD=dev_langfuse_admin_password

# --- Интеграция backend -> Langfuse (langfuse-python SDK, ADR-008) ---
# Ключи API проекта Langfuse (UI -> Settings -> API Keys; dev-значения создаются автоматически
# через LANGFUSE_INIT_* при первом старте стека). Пусто/APP_LANGFUSE_ENABLED=false = выключено;
# backend переживает недоступность Langfuse (таймаут + flush best-effort).
APP_LANGFUSE_ENABLED=true
APP_LANGFUSE_URL=http://langfuse-web:3000
APP_LANGFUSE_PUBLIC_KEY=pk-lf-graphrag-dev
APP_LANGFUSE_SECRET_KEY=sk-lf-graphrag-dev-local

# --- Backend (pydantic-settings APP_*) ---
APP_ENV=dev
APP_LOG_LEVEL=INFO

# --- JWT (HS256, выпуск токенов самим backend'ом, ADR-007) ---
# Секрет обязателен: backend не стартует без него (fail-fast).
# Сменить на длинную случайную строку для любого не-dev окружения!
APP_JWT_SECRET=dev_jwt_secret_change_me_0123456789
APP_JWT_TTL_MINUTES=30
