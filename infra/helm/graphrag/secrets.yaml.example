# ============================================================
# Шаблон секретов Helm-релиза graphrag.
#
#   cp secrets.yaml.example secrets.yaml   <- заполнить реальными значениями
#   helm install ... --values values.yaml --values secrets.yaml
#
# Файл secrets.yaml В GIT НЕ ПОПАДАЕТ (.gitignore).
# В vault.enabled=true режиме jwtSecret/langfuse* дополнительно кладутся
# seed-Job'ом в Vault KV (secret/graphrag/app); пароли БД нужны обеим
# сторонам соединения (контейнеру БД и backend'у), поэтому всегда живут
# в K8s Secret - это осознанный MVP-раздел, см. ADR-010.
# ============================================================

secrets:
  # PostgreSQL (users/roles/sessions/audit)
  postgresPassword: dev_pg_password
  # Neo4j Community (граф знаний); минимум 8 символов
  neo4jPassword: dev_neo4j_password
  # JWT HS256 - выпуск токенов самим backend'ом; сменить для не-dev!
  jwtSecret: dev_jwt_secret_change_me_0123456789
  # Langfuse API-ключи проекта (dev-значения создаются LANGFUSE_INIT_*)
  langfusePublicKey: pk-lf-graphrag-dev
  langfuseSecretKey: sk-lf-graphrag-dev-local
  # Root-токен Vault dev-mode (аргумент запуска + токен seed-Job/initContainer)
  vaultRootToken: dev_root_token
