{
  "info": {
    "_postman_id": "b7e2c1a0-0000-4a1a-9f00-graphrag00009",
    "name": "GraphRAG Platform — E2E (этапы 3–9)",
    "description": "Полный сквозной сценарий (gate этапа 9):\n00-system: health/metrics/trace-echo\n10-auth: логин, ошибки аутентификации\n20-users: управление учётками и RBAC-инварианты ролей (этап 8)\n30-ingest: статус ingestion (read-only), 401/403\n40-chat-rbac: чат non-stream/SSE, память диалога, ACL на цитатах, injection, чужая сессия\ningest-run: ОПЦИОНАЛЬНЫЙ запуск ingestion (в gate не входит: полный прогон жжёт CPU 10–30 мин)\n\nЗапуск: make test-postman (scripts/run_postman.ps1|.sh, newman).\nБазовый URL по умолчанию — Traefik http://api.localhost.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// уникальный суффикс пользователей на весь прогон (повторный запуск не конфликтует)",
          "if (!pm.collectionVariables.get(\"runId\")) {",
          "  pm.collectionVariables.set(\"runId\", Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "adminToken", "value": "" },
    { "key": "adminId", "value": "" },
    { "key": "tokenA", "value": "" },
    { "key": "tokenB", "value": "" },
    { "key": "tokenC", "value": "" },
    { "key": "tokenViewer", "value": "" },
    { "key": "tokenAnalyst", "value": "" },
    { "key": "userAId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "traceE2E", "value": "" }
  ],
  "item": [
    {
      "name": "00-system",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseURL}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Trace headers echo",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Trace-Id", "value": "e2e-trace-{{runId}}" }],
            "url": "{{baseURL}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"эхо X-Trace-Id\", () => pm.expect(pm.response.headers.get(\"x-trace-id\") || \"\").to.include(\"e2e-trace-\"));",
                  "pm.test(\"X-Request-Id присутствует\", () => pm.expect(pm.response.headers.get(\"x-request-id\") || \"\").to.not.be.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Metrics endpoint",
          "request": {
            "method": "GET",
            "url": "{{baseURL}}/metrics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.text();",
                  "pm.test(\"HTTP-метрики присутствуют\", () => pm.expect(body).to.include(\"http_requests_total\"));",
                  "pm.test(\"бизнес-метрики чата присутствуют\", () => pm.expect(body).to.include(\"chat_status_total\"));",
                  "pm.test(\"метрики узлов графа присутствуют\", () => pm.expect(body).to.include(\"graph_node_duration_seconds\"));"
                ]
              }
            }
          ]
        }
      ]
    },
