        <mxCell id="rel_msg_sess" value="session_id → N : 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="pgg" source="chat_sessions" target="sessions">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
