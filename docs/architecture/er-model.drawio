        <mxCell id="rel_sess_users" value="user_id → N : 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="pgg" source="sessions" target="users">
          <mxGeometry relative="1" as="geometry"/>
