        <mxCell id="rel_users_roles" value="N : 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="pgg" source="users" target="roles">
          <mxGeometry relative="1" as="geometry"/>
