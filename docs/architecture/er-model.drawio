        <mxCell id="r_men" value="MENTIONS (LLM)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#9673A6;endArrow=block;exitX=1;exitY=0.75;entryX=0.5;entryY=0;" edge="1" parent="njg" source="act2" target="concept">
          <mxGeometry relative="1" as="geometry"/>
