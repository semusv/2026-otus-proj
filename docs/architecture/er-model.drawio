        <mxCell id="rel_chunks_act" value="payload.act_id → Act.id (логическая связь)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#82B366;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="chunks" target="act">
