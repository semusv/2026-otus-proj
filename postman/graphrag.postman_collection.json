              "pm.test(\"201 сразу с JWT, роль viewer\", () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.role).to.eql(\"viewer\");",
              "});",
              "pm.collectionVariables.set(\"tokenC\", pm.response.json().access_token);"
            ]
          }
